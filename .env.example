AGNOSTIC_AI_PROVIDER=auto
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
AGNOSTIC_DATA_ANALYSER_RESULTS_DIR=/tmp/agnostic-data-analyser/runtime/canonical
AGNOSTIC_CANONICAL_RESULT_MAX_BYTES=1000000
AGNOSTIC_RAW_PAYLOAD_PREVIEW_MAX_BYTES=200000
AGNOSTIC_REVOCATION_STORE=memory
AGNOSTIC_REDIS_URL=
AGNOSTIC_SERVER_HOST=127.0.0.1
AGNOSTIC_SERVER_PORT=8000
AGNOSTIC_SERVER_ACCESS_LOG=false
AGNOSTIC_ANALYSIS_MAX_ROWS_PER_UNIT=100000
AGNOSTIC_ANALYSIS_MAX_UNITS_PER_SOURCE=5
